@@ -0,0 +1,34 @@
+package io.github.ahadporkar.ordertocash.governance;
+import java.util.*;
+/** Transparent keyword baseline, not an LLM and not a semantic intent detector. Ambiguity abstains. */
+public final class DeterministicPlanner implements Planner {
+    @Override public String name() { return "deterministic-baseline"; }
+    @Override public Result plan(Context c) {
+        long started=System.nanoTime();var tools=new ReadTools(c,4);
+        var order=tools.call("lookup_order",Map.of());tools.call("check_inventory",Map.of());
+        tools.call("read_policy",Map.of());var alternatives=tools.call("list_alternatives",Map.of());
+        String s=c.request().toLowerCase(Locale.ROOT);
+        boolean refund=contains(s,"refund","money back","erstattung","erstatten","geld zur");
+        boolean cancel=contains(s,"cancel","stornier","storno");
+        boolean supplier=contains(s,"alternative","another supplier","different supplier","anderen lieferanten","anderer lieferant");
+        boolean unsafe=contains(s,"ignore","bypass","system prompt","skip approval","without approval","ohne freigabe","nicht ","do not ","don't ");
+        int intents=(refund?1:0)+(cancel?1:0)+(supplier?1:0);
+        Proposal p;
+        String citation="POLICY-ORDER-EXCEPTION@"+c.policy().version();
+        if(unsafe||intents!=1) p=new Proposal(Proposal.Action.ESCALATE,0,"","The baseline cannot establish one unambiguous request. Human investigation is required.",List.of(citation));
+        else if(refund) p=new Proposal(Proposal.Action.REFUND,Math.max(0,Json.number(order,"capturedCents",0)-Json.number(order,"refundedCents",0)),"","Propose returning the remaining captured balance, subject to policy and independent approval.",List.of(citation));
+        else if(cancel) p=new Proposal(Proposal.Action.CANCEL,0,"","Propose cancelling this unfulfilled order, subject to payment-state checks and independent approval.",List.of(citation));
+        else {
+            String id="";
+            for(Object v:Json.list(alternatives,"alternatives")) {
+                var a=Json.object(v);
+                if(Json.bool(a,"approved",false)&&Json.number(a,"stock",0)>=Json.number(c.order(),"quantity",1)&&Json.number(a,"unitPriceCents",Long.MAX_VALUE)<=Json.number(c.order(),"unitPriceCents",0)) {id=Json.text(a,"id","");break;}
+            }
+            p=id.isEmpty()?new Proposal(Proposal.Action.ESCALATE,0,"","No approved, in-stock alternative satisfies the price policy.",List.of(citation)):
+                    new Proposal(Proposal.Action.SWITCH_SUPPLIER,0,id,"Propose an approved, in-stock supplier without increasing the unit price. Independent approval is required.",List.of(citation));
+        }
+        return new Result(p,tools.trace(),Data.map("provider",name(),"modelCalls",0,"inputTokens",0,"outputTokens",0,
+                "latencyMs",(System.nanoTime()-started)/1_000_000.0,"estimatedCostUsd",null,"costStatus","not-applicable-no-model"));
+    }
+    private static boolean contains(String s,String... words) { for(String w:words)if(s.contains(w))return true;return false; }
+}
diff --git a/src/main/java/io/github/ahadporkar/ordertocash/governance/FileStateStore.java b/src/main/java/io/github/ahadporkar/ordertocash/governance/FileStateStore.java
new file mode 100644
index 0000000000000000000000000000000000000000..dac6e48a4f87b1ec9f64b5ad269cc31a28e34f29
--- /dev/null
+++ b/src/main/java/io/github/ahadporkar/ordertocash/governance/FileStateStore.java
@@ -0,0 +1,60 @@
+package io.github.ahadporkar.ordertocash.governance;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.Map;
+import java.util.function.Function;
+/** Single-writer demo storage. Atomic replacement plus fsync; use PostgreSQL for multiple replicas. */
+public final class FileStateStore implements StateStore {
+    private final Path directory,file;
+    private final FileChannel lockChannel;
+    private final FileLock lock;
+    private Map<String,Object> state;
+    private boolean closed;
+    public FileStateStore(Path directory) {
+        this.directory=directory.toAbsolutePath().normalize();this.file=this.directory.resolve("governance-state.json");
+        FileChannel channel=null;FileLock held=null;
+        try {
+            Files.createDirectories(this.directory);
+            try { Files.setPosixFilePermissions(this.directory,PosixFilePermissions.fromString("rwx------")); } catch(UnsupportedOperationException ignored) {}
+            channel=FileChannel.open(this.directory.resolve("writer.lock"),StandardOpenOption.CREATE,StandardOpenOption.WRITE);
+            held=channel.tryLock();if(held==null)throw new IllegalStateException("State directory already has a writer");
+            lockChannel=channel;lock=held;
+            if(Files.exists(file)) {
+                if(Files.size(file)>64L*1024*1024)throw new IOException("State size limit");
+                state=Json.object(Json.parseStored(Files.readString(file)));StateStore.validate(state);
+            } else { state=StateStore.empty();persist(state); }
+        } catch(IOException|RuntimeException e) {
+            try { if(held!=null)held.release();if(channel!=null)channel.close(); } catch(IOException ignored) {}
+            throw new IllegalStateException("Cannot open state store; do not delete existing data to bypass an integrity failure",e);
+        }
+    }
+    @Override public synchronized Map<String,Object> transaction(Function<Map<String,Object>,Map<String,Object>> work) {
+        ensureOpen();var draft=Data.copy(state);var result=Data.copy(work.apply(draft));StateStore.validate(draft);
+        persist(draft);state=Data.copy(draft);return result;
+    }
+    @Override public synchronized Map<String,Object> snapshot() { ensureOpen();return Data.copy(state); }
+    private void ensureOpen() { if(closed)throw new IllegalStateException("Store closed"); }
+    private void persist(Map<String,Object> value) {
+        Path temp=directory.resolve("governance-state.tmp");
+        byte[] bytes=Json.stringify(value).getBytes(StandardCharsets.UTF_8);
+        if(bytes.length>64*1024*1024)throw new IllegalStateException("Demo state exceeds 64 MiB; migrate to PostgreSQL");
+        try {
+            try(var c=FileChannel.open(temp,StandardOpenOption.CREATE,StandardOpenOption.TRUNCATE_EXISTING,StandardOpenOption.WRITE)) {
+                ByteBuffer b=ByteBuffer.wrap(bytes);while(b.hasRemaining())c.write(b);c.force(true);
+            }
+            try { Files.setPosixFilePermissions(temp,PosixFilePermissions.fromString("rw-------")); } catch(UnsupportedOperationException ignored) {}
+            Files.move(temp,file,StandardCopyOption.ATOMIC_MOVE,StandardCopyOption.REPLACE_EXISTING);
+            // Directory fsync is available on Unix. Windows does not expose directory channels.
+            try(var d=FileChannel.open(directory,StandardOpenOption.READ)) { d.force(true); }
+            catch(AccessDeniedException e) { if(!System.getProperty("os.name").toLowerCase().contains("win"))throw e; }
+        } catch(IOException e) { closed=true;throw new IllegalStateException("Durable commit failed; restart and inspect the store before retrying",e); }
+    }
+    @Override public synchronized void close() {
+        closed=true;
+        try { if(lock.isValid())lock.release();lockChannel.close(); } catch(IOException e) { throw new IllegalStateException(e); }
+    }
+}
diff --git a/src/main/java/io/github/ahadporkar/ordertocash/governance/GovernanceEngine.java b/src/main/java/io/github/ahadporkar/ordertocash/governance/GovernanceEngine.java
new file mode 100644
index 0000000000000000000000000000000000000000..daaff7bad5d36f60cd660f2115868ca44e80b3db
--- /dev/null
+++ b/src/main/java/io/github/ahadporkar/ordertocash/governance/GovernanceEngine.java
@@ -0,0 +1,230 @@
+package io.github.ahadporkar.ordertocash.governance;
+import java.time.*;
+import java.util.*;
+/**
+ * Application core. Effects update a sandbox order ledger, receipt, audit and outbox in one transaction.
+ * A real payment/supplier connector must add its own idempotency and reconciliation protocol.
+ */
+public final class GovernanceEngine {
+    private final StateStore store;
+    private final Policy policy;
+    private final Clock clock;
+    private final Duration approvalTtl;
+    public GovernanceEngine(StateStore store,Policy policy,Clock clock,Duration approvalTtl) {
+        Problem.require(!approvalTtl.isNegative()&&!approvalTtl.isZero()&&approvalTtl.compareTo(Duration.ofHours(24))<=0,500,"INVALID_APPROVAL_TTL");
+        this.store=store;this.policy=policy;this.clock=clock;this.approvalTtl=approvalTtl;
+    }
+    public GovernanceEngine(StateStore store) { this(store,new Policy("2026-10-12.1"),Clock.systemUTC(),Duration.ofMinutes(15)); }
+    public StateStore store() { return store; }
+    public Policy policy() { return policy; }
+    public Map<String,Object> registerOrder(Actor actor,Map<String,Object> order,boolean replace) {
+        actor.require("ADMIN");var o=Data.copy(order);String id=Data.id(Data.str(o,"id",100));
+        actor.tenant(Data.str(o,"tenant",100));
+        for(String field:List.of("totalCents","capturedCents","refundedCents","unitPriceCents","originalStock"))Data.integer(o,field,0,100_000_000);
+        Data.integer(o,"quantity",1,10_000);Data.str(o,"currency",3);Data.id(Data.str(o,"sku",100));
+        Problem.require(Set.of("UNFULFILLED","READY","SHIPPED","CANCELLED","REFUNDED").contains(o.get("status")),400,"INVALID_STATUS");
+        Problem.require(Json.number(o,"refundedCents",0)<=Json.number(o,"capturedCents",0)&&Json.number(o,"capturedCents",0)<=Json.number(o,"totalCents",0),400,"INVALID_BALANCE");
+        for(Object a:Json.list(o,"alternatives")) {var v=Json.object(a);Data.id(Data.str(v,"id",64));Data.integer(v,"stock",0,100_000_000);Data.integer(v,"unitPriceCents",0,100_000_000);Json.bool(v,"approved",false);}
+        return store.transaction(s->{
+            var orders=Json.map(s,"orders");String key=Data.orderKey(actor.tenant(),id);
+            var old=Json.map(orders,key);
+            if(!old.isEmpty()&&!replace)return old;
+            o.put("version",old.isEmpty()?1:Json.number(old,"version",0)+1);orders.put(key,o);
+            audit(s,actor.tenant(),"",actor.id(),"ORDER_REGISTERED",Data.map("orderId",id,"version",o.get("version")));return o;
+        });
+    }
+    public Map<String,Object> openCase(Actor actor,String orderId,String request,String idempotencyKey) {
+        actor.require("OPERATOR");Data.id(orderId);Data.id(idempotencyKey);
+        Problem.require(request!=null&&!request.isBlank()&&request.length()<=4000,400,"INVALID_REQUEST");
+        String fingerprint=Data.sha(Json.canonical(Data.map("orderId",orderId,"request",request)));
+        return store.transaction(s->{
+            String key=actor.tenant()+"/"+actor.id()+"/"+idempotencyKey;
+            var requests=Json.map(s,"requests");var prior=Json.map(requests,key);
+            if(!prior.isEmpty()) {
+                Problem.require(Data.equal(fingerprint,Json.text(prior,"fingerprint","")),409,"IDEMPOTENCY_CONFLICT");
+                return findCase(s,actor,Json.text(prior,"caseId",""));
+            }
+            findOrder(s,actor.tenant(),orderId);
+            var cases=Json.map(s,"cases");Problem.require(cases.size()<10000,503,"DEMO_CAPACITY_REACHED");
+            String id=UUID.randomUUID().toString();
+            var c=Data.map("id",id,"tenant",actor.tenant(),"orderId",orderId,"request",request,"requestHash",Data.sha(request),
+                    "createdBy",actor.id(),"createdAt",clock.instant().toString(),"state","CREATED","revision",0);
+            cases.put(id,c);requests.put(key,Data.map("fingerprint",fingerprint,"caseId",id));
+            audit(s,actor.tenant(),id,actor.id(),"CASE_OPENED",Data.map("orderId",orderId,"requestHash",c.get("requestHash")));
+            event(s,c,"GovernanceCaseOpened",Data.map("caseId",id,"tenant",actor.tenant()));return c;
+        });
+    }
+    public Map<String,Object> plan(Actor actor,String caseId,Planner planner) {
+        Problem.require(actor.roles().contains("OPERATOR")||actor.roles().contains("WORKER"),403,"ROLE_REQUIRED");
+        Map<String,Object> start=store.transaction(s->{
+            var c=findCase(s,actor,caseId);String state=Json.text(c,"state","");
+            if(!Set.of("CREATED","INVALIDATED","PLANNING").contains(state))return Data.map("existing",c);
+            if("PLANNING".equals(state))Problem.require(!clock.instant().isBefore(Instant.parse(Json.text(c,"leaseUntil",""))),409,"PLANNING_IN_PROGRESS");
+            var order=findOrder(s,actor.tenant(),Json.text(c,"orderId",""));
+            String token=UUID.randomUUID().toString();c.put("state","PLANNING");c.put("planToken",token);
+            c.put("leaseUntil",clock.instant().plusSeconds(120).toString());c.put("revision",Json.number(c,"revision",0)+1);
+            c.remove("approvedBy");c.remove("approvedDigest");c.remove("effectId");
+            audit(s,actor.tenant(),caseId,actor.id(),"PLANNING_STARTED",Data.map("provider",planner.name(),"revision",c.get("revision")));
+            return Data.map("case",c,"order",order,"token",token);
+        });
+        if(start.containsKey("existing"))return Json.map(start,"existing");
+        Planner.Result result;
+        String failure=null;
+        try { result=planner.plan(new Planner.Context(Json.map(start,"order"),Json.text(Json.map(start,"case"),"request",""),policy)); }
+        catch(RuntimeException e) {
+            failure=e instanceof Problem p?p.code:"PLANNER_UNAVAILABLE";
+            result=new Planner.Result(new Proposal(Proposal.Action.ESCALATE,0,"","Automated investigation was unavailable. A human must investigate before any action.",List.of()),List.of(),Data.map("provider",planner.name(),"failure",failure));
+        }
+        final Planner.Result planned=result;final String error=failure;
+        return store.transaction(s->{
+            var c=findCase(s,actor,caseId);
+            Problem.require(Objects.equals(c.get("planToken"),start.get("token"))&&"PLANNING".equals(c.get("state")),409,"STALE_PLAN_RESULT");
+            var order=findOrder(s,actor.tenant(),Json.text(c,"orderId",""));
+            if(Json.number(order,"version",0)!=Json.number(Json.map(start,"order"),"version",-1)) {
+                c.put("state","INVALIDATED");c.put("blockReasons",List.of("ORDER_CHANGED_DURING_PLANNING"));
+                audit(s,actor.tenant(),caseId,actor.id(),"PLAN_INVALIDATED",Data.map("reason","ORDER_CHANGED_DURING_PLANNING"));return c;
+            }
+            Proposal p=planned.proposal();var reasons=new ArrayList<>(policy.violations(order,p));
+            Set<String> evidence=new HashSet<>();for(var t:planned.trace())evidence.add(Json.text(t,"tool",""));
+            if(p.action()!=Proposal.Action.ESCALATE&&(!evidence.contains("lookup_order")||!evidence.contains("read_policy")))reasons.add("REQUIRED_EVIDENCE_NOT_READ");
+            if(p.action()==Proposal.Action.SWITCH_SUPPLIER&&!evidence.contains("list_alternatives"))reasons.add("ALTERNATIVES_NOT_READ");
+            c.put("proposal",p.toMap());c.put("trace",planned.trace());c.put("usage",planned.usage());
+            c.put("orderVersion",order.get("version"));c.put("policyVersion",policy.version());
+            c.put("expiresAt",clock.instant().plus(approvalTtl).toString());c.put("proposalDigest",digest(c));c.put("blockReasons",reasons);
